{
  "compilerOptions": {
      "target": "ES2016",
    "downlevelIteration": true,
    "lib": ["dom", "dom.iterable", "esnext", "ESNext", "DOM"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/app/components/layouts/customs/loading/Loading.jsx", "src/app/api/movies/route.ts", "src/app/api/movies/[id]/route.ts", "src/app/utils/constants/data/components/layouts/admin/admin_dataDrawerNavAdmin.js", "src/app/pages/admin/webRadios/newWebRadio/page.tsx", "src/app/pages/admin/movies/newMovie/page.tsx", "src/app/pages/movies/movie/[id]/page.tsx", "src/app/pages/movies/allMovies/desktop/AllMovies_Desktop_Page.tsx", "src/app/pages/movies/allMovies/cellular/AllMovies_Cellular_Page.jsx", "src/app/pages/intro/cellular/Intro_Cellular.jsx", "src/app/pages/intro/desktop/Intro_Desktop.jsx"],
  "exclude": ["node_modules"]
}
