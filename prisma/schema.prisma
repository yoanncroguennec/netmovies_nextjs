// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName       String
  lastName        String
  email           String   @unique
  password        String
  dateBirthday    DateTime
  ipAddressUser   String?
  token           String?
  salt            String?
  hash            String?
  deviceId        String?
  role            Role     @default(user) // <-- Ici, role par défaut = user
}

model WebRadio {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  img   String
  fluxUrl   String
  createdAt DateTime @default(now())
}

model Movie {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId// L'identifiant unique du film, stocké sous forme de ObjectIddans MongoDB.
  name String?
  realisators String[]
  actors String[]
  desc String?
  trailer String?
  favorite Boolean?
  watch Boolean?
  country String[]
  productionCompany String?
  movieLink String?
  img       String?  // ← ici : image optionnelle (ou `String` si obligatoire)
  imgCover String?
  imgPoster String?
  year Int
  genre String[]
  rating String?
}
